:root {
  color: #f4f8fb;
  background: #091827;
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  min-height: 100%;
  height: 100%;
  margin: 0;
}

body {
  background:
    radial-gradient(circle at top, rgba(48, 117, 215, 0.28), transparent 30%),
    #071521;
}

button, input {
  font: inherit;
}

button {
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: linear-gradient(180deg, #1c2c4a, #101d2e);
  color: #edf7ff;
  border-radius: 10px;
  padding: 0.7rem 1rem;
  cursor: pointer;
  transition: transform 0.15s ease, border-color 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
  border-color: rgba(118, 189, 255, 0.7);
}

button.active {
  border-color: rgba(118, 189, 255, 0.9);
  box-shadow: 0 0 0 1px rgba(118, 189, 255, 0.45);
}

input[type='range'] {
  width: 100%;
}

input[type='url'], input[type='text'], .project-name {
  width: 100%;
  border-radius: 10px;
  padding: 0.7rem 0.8rem;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(11, 20, 29, 0.8);
  color: #f4f8fb;
}

.app-shell {
  max-width: 1480px;
  margin: 0 auto;
  padding: 1.5rem;
}

.topbar {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: center;
  margin-bottom: 1.25rem;
}

.topbar-title-block {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 240px;
}

.eyebrow {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12rem;
  color: #7dd3fc;
}

.project-name {
  font-size: 1.6rem;
  font-weight: 700;
}

.topbar-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.main-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(320px, 1fr);
  gap: 1.25rem;
}

.panel {
  background: rgba(11, 25, 37, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  padding: 1rem;
  box-shadow: 0 12px 32px rgba(2, 8, 18, 0.4);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
}

.panel-header h2 {
  margin: 0;
  font-size: 1.1rem;
}

.source-tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.source-tabs button {
  flex: 1;
}

.upload-box,
.youtube-box {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.upload-box {
  border: 1px dashed rgba(125, 211, 252, 0.5);
  border-radius: 14px;
  padding: 1rem;
  background: rgba(17, 34, 46, 0.7);
}

.upload-box input {
  max-width: 220px;
}

.youtube-box input {
  flex: 1;
}

.stage {
  background: rgba(5, 11, 17, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage video,
.stage iframe {
  width: 100%;
  height: 100%;
  border: 0;
  background: #000;
}

.empty-state {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(216, 232, 245, 0.7);
  font-size: 1.1rem;
  letter-spacing: 0.02rem;
}

.empty-state.small {
  min-height: 96px;
}

.time-bar {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 0.8rem;
  margin-top: 0.85rem;
}

.selection-box {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  margin-bottom: 1rem;
}

.selection-values {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.selection-values label {
  display: grid;
  grid-template-columns: 80px 1fr 52px;
  gap: 0.8rem;
  align-items: center;
}

.selection-tools {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.timeline-header {
  margin-top: 0.8rem;
}

.timeline-wrap {
  position: relative;
  border-radius: 14px;
  background: rgba(7, 17, 25, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
  min-height: 140px;
}

.timeline-ruler {
  position: relative;
  min-height: 140px;
  background-image: linear-gradient(to right, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
  background-size: 40px 100%;
}

.playhead,
.selection-highlight,
.voice-block {
  position: absolute;
  top: 0;
  bottom: 0;
}

.playhead {
  width: 2px;
  background: #7dd3fc;
  box-shadow: 0 0 16px rgba(125, 211, 252, 0.8);
}

.selection-highlight {
  background: rgba(61, 133, 255, 0.22);
  border: 1px solid rgba(125, 211, 252, 0.7);
  border-radius: 10px;
}

.voice-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0.35rem 0.5rem;
  background: linear-gradient(90deg, #1d7ca9, #3f7ef5);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 10px;
  color: white;
  overflow: hidden;
  min-width: 80px;
  z-index: 2;
}

.voice-block span {
  font-weight: 600;
  white-space: nowrap;
}

.voice-block small {
  opacity: 0.9;
}

.mix-panel {
  margin-top: 1.25rem;
}

.mix-controls {
  display: grid;
  grid-template-columns: repeat(2, minmax(220px, 1fr));
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.mix-controls label {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.5rem 0.75rem;
  align-items: center;
}

.mix-controls label span,
.segment-slider label span {
  min-width: 36px;
  text-align: right;
}

.segment-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.segment-card {
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(12, 25, 36, 0.74);
  border-radius: 14px;
  padding: 0.8rem;
}

.segment-meta {
  display: flex;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.segment-actions {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.75rem;
}

.segment-slider label {
  display: grid;
  grid-template-columns: 80px 1fr 40px;
  gap: 0.7rem;
  align-items: center;
}

.status-bar {
  margin-top: 1.25rem;
  border-radius: 12px;
  background: rgba(11, 25, 37, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 0.8rem 1rem;
  color: #d7ebff;
}

@media (max-width: 980px) {
  .main-grid {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .mix-controls {
    grid-template-columns: 1fr;
  }
}
